<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISOS DE RED -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- PERMISOS DE LLAMADAS Y MULTIMEDIA -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- PERMISO DE CONTACTOS -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- CARACTERÍSTICAS DE HARDWARE -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeminarioFinal"
        android:usesCleartextTraffic="true">

        <!-- 1. PANTALLA INICIAL: Onboarding -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. PANTALLA PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 3. PERFIL DE USUARIO -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 4. NUEVO CHAT -->
        <activity
            android:name=".NewChatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 5. CHAT / CONVERSACIÓN -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 6. GRUPOS -->
        <activity
            android:name=".GroupActivity"
            android:exported="false"
            android:parentActivityName=".ChatActivity" />

        <!-- 7. LLAMADAS DE VOZ Y VIDEO -->
        <activity
            android:name=".CallActivity"
            android:exported="false" />

        <!-- 8. EDITAR PERFIL -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity" />

        <!-- 9. AJUSTES Y SEGURIDAD -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity" />

        <!-- 10. ACERCA DE -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <!-- 11. TÉRMINOS Y CONDICIONES -->
        <activity
            android:name=".TermsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <!-- 12. HISTORIAL DE LLAMADAS -->
        <activity
            android:name=".CallHistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>